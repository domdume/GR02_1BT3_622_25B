<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>MiembroServlet</servlet-name>
        <servlet-class>servlet.MiembroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MiembroServlet</servlet-name>
        <url-pattern>/miembros</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>QuehacerServlet</servlet-name>
        <servlet-class>servlet.QuehacerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>QuehacerServlet</servlet-name>
        <url-pattern>/quehaceres</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>servlet.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>IncentivoServlet</servlet-name>
        <servlet-class>servlet.IncentivoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IncentivoServlet</servlet-name>
        <url-pattern>/incentivos</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RachaServlet</servlet-name>
        <servlet-class>servlet.RachaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RachaServlet</servlet-name>
        <url-pattern>/rachas</url-pattern>
    </servlet-mapping>

    <!-- Nuevo servlet para proteger/desproteger rachas -->
    <servlet>
        <servlet-name>CongelarRachaServlet</servlet-name>
        <servlet-class>servlet.CongelarRachaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CongelarRachaServlet</servlet-name>
        <url-pattern>/miembros/congelar</url-pattern>
    </servlet-mapping>
</web-app>